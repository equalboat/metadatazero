{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stillgrain",
  "version": "1.2.0",
  "identifier": "com.metadatazero.localoptimize",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Stillgrain",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; connect-src 'self' ipc: https://ipc.localhost; img-src 'self' data: blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "binaries/**/*"
    ],
    "externalBin": [
      "binaries/exiftool"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMzRTc5OUY2RDlERjlCMTYKUldRV205L1o5cG5ud3pqOFA1NEw0TFkrbTNheWFUOEo0SmFkRzRSZnl3ak5MWHFkYXIveXp3U1oK",
      "endpoints": [
        "https://github.com/equalboat/metadatazero/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
